{
  "dependencies": [".", "src"],
  "graphs": {
    "threadwise-financial-agent": "ai_agent.agents.chat_graph:agent"
  },
  "checkpointer": {
    "ttl": {
      "strategy": "delete",
      "default_ttl": 129600,
      "sweep_interval_minutes": 60
    }
  },
  "env": ".env",
  "image_distro": "wolfi",
  "http": {
    "app": "ai_agent.main:app",
    "cors": {
      "allow_origins": ["http://localhost:5174", "http://localhost:5180"],
      "allow_methods": ["GET", "POST", "PUT", "PATCH", "DELETE", "OPTIONS"],
      "allow_headers": ["Authorization", "Content-Type", "X-Request-Id"],
      "allow_credentials": false
    }
  },
  "auth": {
    "path": "./src/ai_agent/auth.py:auth"
  }
}
