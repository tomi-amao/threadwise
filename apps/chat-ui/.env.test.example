# Local e2e environment. Copy to .env.test (gitignored), or let `pnpm e2e:env` create it.
#
# SAFETY: these must point at the LOCAL Supabase stack (`supabase start`). The e2e
# tooling refuses to run against anything that is not localhost / 127.0.0.1.
# Never put hosted-project keys in this file.
#
# The Supabase URL and keys below are written by `pnpm e2e:env` from `supabase status`.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Throwaway account created by the seed. Local database only; safe to change.
E2E_USER_EMAIL=e2e@threadwise.test
E2E_USER_PASSWORD=zHKc62aag6NCxdHjQsMPs-H3
