{
  "name": "threadwise-chat-ui",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "dev": "react-router dev",
    "start": "react-router-serve ./build/server/index.js",
    "typecheck": "react-router typegen && tsc",
    "e2e:env": "tsx e2e/write-env.ts",
    "e2e:seed": "tsx e2e/seed/seed.ts",
    "test:e2e": "playwright test",
    "test:e2e:quick": "playwright test --project=desktop-light",
    "test:e2e:changed": "playwright test --project=desktop-light --only-changed=main",
    "test:e2e:mutations": "E2E_MUTATIONS_ONLY=1 playwright test --project=mutations",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@floating-ui/react-dom": "^2.1.6",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@langchain/core": "^1.2.11",
    "@langchain/langgraph-sdk": "^1.11.0",
    "@nivo/bar": "^0.99.0",
    "@nivo/line": "^0.99.0",
    "@nivo/pie": "^0.99.0",
    "@radix-ui/react-context-menu": "^2.3.7",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dismissable-layer": "^1.1.19",
    "@radix-ui/react-focus-scope": "^1.1.16",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-select": "^2.3.7",
    "@react-router/node": "^7.18.4",
    "@react-router/serve": "^8.4.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.116.0",
    "@types/react-syntax-highlighter": "^15.5.13",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "inngest": "^4.20.0",
    "isbot": "^5.2.2",
    "katex": "^0.16.47",
    "lucide-react": "^1.46.0",
    "phosphor-react": "^1.4.1",
    "react": "^19.3.0",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "react-router": "^7.18.4",
    "react-syntax-highlighter": "^16.1.1",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss-animate": "^1.0.7",
    "uuid": "^14.0.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@react-router/dev": "^7.18.4",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^20.19.43",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vite-plugin-devtools-json": "^1.1.0",
    "vite-tsconfig-paths": "^5.1.4"
  }
