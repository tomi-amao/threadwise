# Development Environment Variables
# Copy this file to .env.local and update values as needed

# React Router App
VITE_API_URL=http://localhost:2024
VITE_APP_ENV=development

# AI Agent API
OPENAI_API_KEY=your_openai_api_key_here
SUPABASE_URL=your_supabase_url_here
SUPABASE_ANON_KEY=your_supabase_anon_key_here
# Required for server-side Supabase calls (bypasses RLS in trusted server code).
# Get from: Supabase Dashboard → Settings → API → service_role secret
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
DATABASE_URL=postgresql://threadwise:threadwise@localhost:5432/threadwise
REDIS_URL=redis://localhost:6379

# Zoho Calendar OAuth — ThreadWise's own registered OAuth client (app-wide).
# Unlike Shopify/PayPal/Revolut/Squarespace, where each user supplies their own
# provider credentials via the Integrations UI, Zoho Calendar needs real
# user-consent OAuth against a calendar that belongs to one specific person —
# there's no per-user custom-app shortcut for that, so ThreadWise itself is
# the registered client here. Register an app at https://api-console.zoho.com
# (or the console for your region's data center) to get these values.
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
# Must match the host actually serving the backend's /oauth/* routes AND
# the Authorized Redirect URI registered in Zoho's API Console, exactly.
# langgraph.json mounts the same FastAPI app inside `langgraph dev` via its
# `http.app` key, so under the documented `pnpm dev:all` workflow this is
# :2024 (langgraph dev's port), not :8000 — :8000 only applies if you're
# running the backend via plain `pnpm dev:ai-agent` (uvicorn) instead.
ZOHO_REDIRECT_URI=http://localhost:2024/oauth/zoho_calendar/callback
# Match whichever data center your Zoho account is on — UK/EU accounts are
# commonly accounts.zoho.eu, not the default accounts.zoho.com.
ZOHO_ACCOUNTS_DOMAIN=accounts.zoho.com
# Where the OAuth callback redirects the browser back to after connecting —
# the AI agent backend has no other reason to know the frontend's origin.
FRONTEND_URL=http://localhost:5174

# Development Settings
LOG_LEVEL=debug
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
