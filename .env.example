# Development Environment Variables
# Copy this file to .env.local and update values as needed

# React Router App
VITE_API_URL=http://localhost:2024
VITE_APP_ENV=development

# AI Agent API
OPENAI_API_KEY=your_openai_api_key_here
SUPABASE_URL=your_supabase_url_here
SUPABASE_ANON_KEY=your_supabase_anon_key_here
# Required for server-side Supabase calls (bypasses RLS in trusted server code).
# Get from: Supabase Dashboard → Settings → API → service_role secret
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
DATABASE_URL=postgresql://threadwise:threadwise@localhost:5432/threadwise
REDIS_URL=redis://localhost:6379

# Development Settings
LOG_LEVEL=debug
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
