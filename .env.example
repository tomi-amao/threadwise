# Development Environment Variables
# Copy this file to .env.local and update values as needed

# React Router App
VITE_API_URL=http://localhost:2024
VITE_APP_ENV=development

# AI Agent API
OPENAI_API_KEY=your_openai_api_key_here
SUPABASE_URL=your_supabase_url_here
SUPABASE_PUBLISHABLE_KEY=your_sb_publishable_key_here
# Required for server-side Supabase calls (bypasses RLS in trusted server code).
# Get from: Supabase Dashboard → Settings → API Keys → Secret keys (sb_secret_…)
SUPABASE_SECRET_KEY=your_sb_secret_key_here
DATABASE_URL=postgresql://threadwise:threadwise@localhost:5432/threadwise
REDIS_URL=redis://localhost:6379

# Zoho Calendar OAuth — ThreadWise's own registered OAuth client (app-wide).
# Unlike Shopify/PayPal/Revolut/Squarespace, where each user supplies their own
# provider credentials via the Integrations UI, Zoho Calendar needs real
# user-consent OAuth against a calendar that belongs to one specific person —
# there's no per-user custom-app shortcut for that, so ThreadWise itself is
# the registered client here. Register an app at https://api-console.zoho.com
# (or the console for your region's data center) to get these values.
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
# Must match the host actually serving the backend's /oauth/* routes AND
# the Authorized Redirect URI registered in Zoho's API Console, exactly.
# langgraph.json mounts the same FastAPI app inside `langgraph dev` via its
# `http.app` key, so under the documented `pnpm dev:all` workflow this is
# :2024 (langgraph dev's port), not :8000 — :8000 only applies if you're
# running the backend via plain `pnpm dev:ai-agent` (uvicorn) instead.
ZOHO_REDIRECT_URI=http://localhost:2024/oauth/zoho_calendar/callback
# Match whichever data center your Zoho account is on — UK/EU accounts are
# commonly accounts.zoho.eu, not the default accounts.zoho.com.
ZOHO_ACCOUNTS_DOMAIN=accounts.zoho.com
# Where the OAuth callback redirects the browser back to after connecting —
# the AI agent backend has no other reason to know the frontend's origin.
FRONTEND_URL=http://localhost:5174

# AI agent: who may call it
# The agent checks every request. Users send their Supabase access token (nothing to
# configure; it is verified against the project's public signing keys). The values below
# cover the rest.
#
# Secret for machine callers (scripts, operators, cron) of the internal-only routes, sent as
# an `X-Internal-Key` header. The browser app never uses it. Leave unset and those routes stay
# closed to everyone. Generate one with: openssl rand -hex 32
INTERNAL_API_KEY=
# Origins the browser app is served from, comma-separated. Anything else is refused by CORS.
# Set this to your real frontend origin(s) in production.
CORS_ALLOW_ORIGINS=http://localhost:5174,http://localhost:5180
# Only for an older Supabase project that still signs user tokens with a shared secret
# (Dashboard -> Settings -> API -> JWT Secret). Newer projects and the local stack do not need it.
# SUPABASE_JWT_SECRET=
# Production: set INNGEST_SIGNING_KEY (and leave INNGEST_DEV unset) so /api/inngest only accepts
# requests signed by Inngest.

# Development Settings
LOG_LEVEL=debug

# Docker Compose (docker-compose.yml reads these from the root .env)
# The self-hosted LangGraph server refuses to start without a LangSmith key.
LANGSMITH_API_KEY=
# Production only: licence key for self-hosted LangGraph (instead of LANGSMITH_API_KEY).
LANGGRAPH_CLOUD_LICENSE_KEY=
GOOGLE_API_KEY=
# SUPABASE_URL must work from the containers AND the browser. Hosted project: its https URL.
# Local CLI stack (pnpm db:start): http://host.docker.internal:54321 (Docker Desktop also maps
# that name to 127.0.0.1 in the host's hosts file, so the browser can resolve it too).
# DATABASE_URL for the local stack: postgresql://postgres:postgres@host.docker.internal:54322/postgres
# Inngest: leave unset to use the inngest container (http://inngest:8288).
# INNGEST_DEV=
